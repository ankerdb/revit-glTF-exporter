<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>8.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>AnkerGltfExporter</AssemblyName>
		<Configurations>Debug;Release</Configurations>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PlatformTarget>x64</PlatformTarget>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyTitle>AnkerGltfExporter</AssemblyTitle>
		<AssemblyProduct>AnkerGltfExporter</AssemblyProduct>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.0</FileVersion>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>TRACE;DEBUG;REVIT2025</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Release'))">
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DefineConstants>TRACE;DEBUG;REVIT2025</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Draco_transcoder" Version="3.5.0" />
		<PackageReference Include="MeshOptimizer_glTFPack" Version="2.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
		<PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.6" />
	</ItemGroup>
	<Import Project="..\Common_glTF_Exporter\Common_glTF_Exporter.projitems" Label="Shared" />
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<DistributionFiles Include="$(OutputPath)AnkerGltfExporter.dll" />
			<DistributionFiles Include="$(OutputPath)System.Drawing.Common.dll" />
			<DistributionFiles Include="$(OutputPath)DracoWrapper.dll" />
			<DistributionFiles Include="$(OutputPath)MeshOpt.dll" />
		</ItemGroup>
		<MakeDir Directories="$(SolutionDir)Distribution\2025" />
		<Copy SourceFiles="@(DistributionFiles)" DestinationFolder="$(SolutionDir)Distribution\2025" />
		<Message Text="Distribution files copied to: $(SolutionDir)Distribution\2025" Importance="high" />
	</Target>
</Project>